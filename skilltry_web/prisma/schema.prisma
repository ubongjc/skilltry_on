// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

// User model with authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          Role      @default(USER)

  // WebAuthn/Passkey credentials
  credentials   Credential[]

  // User attempts and reports
  attempts      Attempt[]

  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Soft delete
  deletedAt     DateTime?

  @@index([email])
  @@index([role])
  @@map("users")
}

enum Role {
  USER
  ADMIN
  INSTITUTION
}

// WebAuthn/Passkey credentials
model Credential {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId      String   @unique
  publicKey         Bytes
  counter           BigInt

  deviceType        String?
  backedUp          Boolean  @default(false)
  transports        String[]

  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?

  @@index([userId])
  @@map("credentials")
}

// Job simulation scenarios
model Simulation {
  id            String   @id @default(cuid())
  title         String
  description   String?
  sector        String
  difficulty    String   @default("MEDIUM")

  // Duration in minutes
  estimatedDuration Int    @default(10)

  // Structured steps as JSON
  steps         Json

  // Rubric for scoring
  rubric        Json

  // Training links and resources
  resources     Json?

  // Media assets
  thumbnailUrl  String?
  mediaUrls     String[]

  // Metadata
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  attempts      Attempt[]

  @@index([sector])
  @@index([isPublished])
  @@map("simulations")
}

// User attempts at simulations
model Attempt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  simulationId    String
  simulation      Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  // Rubric scores as JSON
  rubricScores    Json

  // Overall score (0-100)
  overallScore    Float

  // AI-generated feedback
  feedback        String?

  // User responses/actions
  responses       Json

  // Client-side encrypted media (ciphertext URLs)
  encryptedMedia  String[]

  // Completion status
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?

  // Time taken in seconds
  duration        Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([simulationId])
  @@index([status])
  @@map("attempts")
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// Stripe subscriptions and entitlements
model Subscription {
  id                String   @id @default(cuid())
  userId            String?
  institutionId     String?

  stripeCustomerId      String   @unique
  stripeSubscriptionId  String   @unique
  stripePriceId         String
  stripeStatus          String

  plan              SubscriptionPlan
  status            String

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([institutionId])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  INDIVIDUAL
  INSTITUTION
  ENTERPRISE
}

// Analytics events (anonymized)
model AnalyticsEvent {
  id              String   @id @default(cuid())

  // Anonymized user identifier (hashed)
  userHash        String

  eventType       String
  eventData       Json

  // Session tracking
  sessionId       String

  // Metadata
  createdAt       DateTime @default(now())
  userAgent       String?
  ipHash          String?

  @@index([userHash])
  @@index([eventType])
  @@index([createdAt])
  @@map("analytics_events")
}

// Data Subject Requests (GDPR compliance)
model DataSubjectRequest {
  id              String   @id @default(cuid())
  userId          String

  requestType     DSRType
  status          DSRStatus @default(PENDING)

  // Export data URL (temporary signed URL)
  exportUrl       String?

  requestedAt     DateTime @default(now())
  processedAt     DateTime?
  completedAt     DateTime?

  @@index([userId])
  @@index([status])
  @@map("data_subject_requests")
}

enum DSRType {
  EXPORT
  DELETE
}

enum DSRStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
